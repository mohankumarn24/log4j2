<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 Configuration for Spring Boot (v2.7.x)
  - Console + Rolling File appenders
  - Rolling by time (daily) and size (10 MB)
  - Keeps last 10 compressed log files
  - Environment variable for log directory (LOG_DIR)
  - Custom log levels for service & controller packages
-->

<Configuration status="WARN">

    <!-- ===========================
         Properties: Variables used in the configuration
         =========================== -->
    <Properties>
        <!-- Directory where logs will be stored -->
        <Property name="LOG_DIR">logs</Property>

        <!-- Log pattern: timestamp, thread, level, logger, message, throwable -->
        <Property name="LOG_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable
        </Property>
    </Properties>


    <!-- ===========================
         Appenders: Destinations for logs
         =========================== -->
    <Appenders>

        <!-- Console Appender: Logs to system console -->
        <Console name="Console" target="SYSTEM_OUT">
            <!-- Optional: only allow INFO and above in console -->
            <Filters>
                <ThresholdFilter level="info" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>

            <!-- Use the common log pattern -->
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>


        <!-- Rolling File Appender: Logs to file with rotation -->
        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/app.log"
                     filePattern="${LOG_DIR}/app-%d{yyyy-MM-dd}-%i.log.gz">

            <!-- Log pattern for file -->
            <PatternLayout>
                <pattern>${LOG_PATTERN}</pattern>
            </PatternLayout>

            <!-- Rolling policies: roll daily or if file > 10MB -->
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>

            <!-- Keep up to 10 old logs -->
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

    </Appenders>


    <!-- ===========================
         Loggers: Define log levels for different packages/classes
         =========================== -->
    <Loggers>

        <!-- Root logger: default for all classes -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>

        <!-- Service package logger: DEBUG level -->
        <Logger name="net.project.loggers.service" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- UserController logger: TRACE level for full detail -->
        <Logger name="net.project.loggers.controller.UserController" level="trace" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

    </Loggers>

</Configuration>
